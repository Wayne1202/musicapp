EXPO_PUBLIC_API_URL="http://localhost:4000"
EXPO_PUBLIC_SOCKET_URL="http://localhost:4000"
# Used only to build the invite link/QR code (InviteDialog) — a URL anyone can open in a browser
# to join the room, since not every invitee will have this app installed. Defaults to the live
# deployed web app if unset.
EXPO_PUBLIC_WEB_ORIGIN="https://musicapp-web-fawn.vercel.app"

# "localhost" works from the iOS Simulator and Expo web (they share this Mac's network stack),
# but NOT from a physical device or the Android emulator:
#   - Physical device (Expo Go): use this Mac's LAN IP, e.g. "http://192.168.1.23:4000"
#   - Android emulator: use "http://10.0.2.2:4000" (the emulator's alias for the host machine)
